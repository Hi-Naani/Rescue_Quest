  m_Maskable: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Objective :- \n\n - Rescue your friend trapped inside the house by defeating
    enemies across three levels.\n\nGameplay :-\n\n - You must clear three levels
    before unlocking the house.\n - In each level, defeat 15 enemies to activate
    the portal to the next level.\n - After clearing Level 3, return to Level 1 to
    enter the house and win.\n - Each level has enemies of increasing difficulty.\n
    - You can attack any enemy, but using the level-specific weapon makes it easier.\n\nWeapons
    & Levels :-\n\n- Level 1 (Easy) \u2013 Find a sword , defeat non-attacking enemies.\n
    - Level 2 (Medium) \u2013 Find a staff, defeat attacking enemies.\n - Level 3
    (Hard) \u2013 Find a bow, defeat stronger attacking enemies.\n\n\nControls :-\n\n
    - WASD \u2013 Move the player.\n - Mouse Left/Right \u2013 Determines player\u2019s
    facing direction.\n - Left Mouse Click \u2013 Attack.\n - Space + WASD \u2013
    Stamina Boost (temporary speed increase).\n- Escape (Esc) \u2013 Pause game /
    Go back.\n\n\nCollectibles:-\n\n- Stamina Boosters \u2013 Increases stamina for
    dashing.\n - Health Globes \u2013 Restores health.\n - Coins \u2013 Each coin
    reduces time by 0.25 seconds, improving your score.\n\nScoring :-\n\n- Your best
    score is based on how quickly you complete the game.\n(Total Time - Coins Collected
    \xD7 0.25 sec)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
